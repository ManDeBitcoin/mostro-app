# Web build of the upstream Mostro app (MostroP2P/app), served by nginx.
#
# This fork tracks upstream and adds only what a Docker host such as Coolify
# needs: this file, .dockerignore and docker/. See docker/README.md.
#
# The build follows .github/workflows/web-build.yml — the steps upstream CI
# validates and deploys. When upstream changes a tool version there, change the
# matching ARG below (or pass it as a build argument).

# ── Build stage ──────────────────────────────────────────────────────────────
FROM ubuntu:22.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive

# Toolchain, pinned to web-build.yml's env.
ARG FLUTTER_VERSION=3.41.9
ARG RUST_VERSION=1.97.0
ARG WASM_PACK_VERSION=0.15.0

# Path the app is served under. "/" for its own (sub)domain; a sub-path must
# start and end with "/", and nginx has to serve it there too.
ARG BASE_HREF=/
# Web push, as upstream's build takes them (repository variables there). Both
# are compiled in and public; empty leaves web push off.
ARG FCM_VAPID_KEY=
ARG PUSH_WEB_ENABLED=

# clang: C dependencies (secp256k1) compiled to wasm32. python3: the shared
# memory check in build-web.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git unzip xz-utils zip \
      build-essential clang pkg-config libssl-dev python3 \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/flutter/bin:$PATH

# Pinned stable stays the default toolchain. scripts/build-web.sh selects
# nightly itself (-Z build-std for wasm threads) — the current one, as in
# upstream CI.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rustup toolchain install nightly --profile minimal \
         --target wasm32-unknown-unknown --component rust-src
RUN cargo install wasm-pack --version "${WASM_PACK_VERSION}" --locked

RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" https://github.com/flutter/flutter.git /flutter \
    && flutter config --no-analytics \
    && flutter precache --web

WORKDIR /app

COPY . .

# lib/src/rust/ and rust/src/frb_generated.rs are committed and checked by
# upstream CI, so they are used as they are: no codegen here.
RUN flutter pub get \
    && ./scripts/build-web.sh --release

RUN flutter build web \
      --release \
      --base-href "${BASE_HREF}" \
      --pwa-strategy=none \
      --dart-define=FCM_VAPID_KEY="${FCM_VAPID_KEY}" \
      --dart-define=PUSH_WEB_ENABLED="${PUSH_WEB_ENABLED}"

# The two blank-page failure modes web-build.yml guards against, plus the files
# the page cannot start without.
RUN set -eu; cd build/web; \
    for f in index.html flutter_bootstrap.js coi-serviceworker.min.js pkg/rust_bg.wasm; do \
      test -s "$f" || { echo "missing from the bundle: $f" >&2; exit 1; }; \
    done; \
    grep -q 'coi-serviceworker.min.js' index.html \
      || { echo "index.html does not load coi-serviceworker.min.js" >&2; exit 1; }; \
    grep -q "base href=\"${BASE_HREF}\"" index.html \
      || { echo "base href is not ${BASE_HREF}" >&2; exit 1; }; \
    loader_call="$(grep -o '_flutter\.loader\.load([^;]*)' flutter_bootstrap.js | tail -n 1)"; \
    test -n "$loader_call" \
      || { echo "flutter_bootstrap.js does not call _flutter.loader.load" >&2; exit 1; }; \
    case "$loader_call" in *serviceWorkerSettings*) \
      echo "Flutter's service worker is registered (expected --pwa-strategy=none)" >&2; exit 1;; \
    esac

# ── Serve stage ──────────────────────────────────────────────────────────────
FROM nginx:1.29-alpine

COPY --from=builder /app/build/web /usr/share/nginx/html
# Cross-origin isolation headers and the cache policy: see docker/nginx.conf.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
