# Build Stage
FROM ubuntu:22.04 AS builder

# Prevent tzdata interactive prompt
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl git unzip xz-utils zip libglu1-mesa clang cmake ninja-build pkg-config \
    libgtk-3-dev python3

# Install Rust nightly & wasm-pack
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup target add wasm32-unknown-unknown --toolchain nightly
RUN rustup component add rust-src --toolchain nightly
RUN cargo install wasm-pack

# Install Flutter
RUN git clone https://github.com/flutter/flutter.git -b stable /flutter
ENV PATH="/flutter/bin:${PATH}"
# Run doctor to pre-download Dart SDK
RUN flutter doctor

WORKDIR /app
# Copy the source code
COPY . .

# Build Rust WASM core
RUN ./scripts/build-web.sh --release

# Build Flutter Web App
RUN flutter build web --release --base-href "/" --pwa-strategy=none

# Serve Stage
FROM nginx:alpine

# Copy built static files to NGINX
COPY --from=builder /app/build/web /usr/share/nginx/html

# Copy custom NGINX configuration with cache busting and Cross-Origin Isolation
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
